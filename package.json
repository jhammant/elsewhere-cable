{
  "name": "elsewhere-cable",
  "version": "0.0.1",
  "private": true,
  "description": "Infinite television from places that do not exist.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm -r build",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm --filter @elsewhere-cable/renderer dev",
    "preview": "pnpm --filter @elsewhere-cable/renderer preview",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "diagnose": "tsx infra/scripts/diagnose.ts --output data/system-profile.json",
    "seed": "pnpm --filter @elsewhere-cable/generation-worker generate -- --demo --if-empty --count 4",
    "generate:batch": "pnpm --filter @elsewhere-cable/generation-worker generate",
    "generate:live:bootstrap": "tsx infra/scripts/bootstrap-live-queue.ts",
    "reservoir:status": "tsx infra/scripts/reservoir-status.ts",
    "reservoir:audit": "tsx infra/scripts/audit-reservoir.ts",
    "reservoir:deduplicate-content": "tsx infra/scripts/deduplicate-reservoir-content.ts",
    "reservoir:revoice": "tsx infra/scripts/revoice-reservoir.ts",
    "reservoir:emergency-refill": "tsx infra/scripts/emergency-refill.ts",
    "reservoir:prioritise-recent": "tsx infra/scripts/prioritise-recent-segments.ts",
    "reservoir:prioritise-live": "tsx infra/scripts/prioritise-live-originals.ts",
    "reservoir:remove": "tsx infra/scripts/remove-manifest-segments.ts",
    "reservoir:repair-medium": "tsx infra/scripts/repair-segment-medium.ts",
    "reservoir:tighten-tails": "tsx infra/scripts/tighten-segment-tails.ts",
    "reservoir:tighten-dialogue": "tsx infra/scripts/tighten-dialogue-gaps.ts",
    "reservoir:energise": "tsx infra/scripts/energise-reservoir.ts",
    "reservoir:content-runway": "tsx infra/scripts/content-runway.ts",
    "endor:content:check": "tsx infra/scripts/check-endor-content-compatibility.ts",
    "endor:renderer:refresh": "sh infra/scripts/refresh-endor-renderer.sh",
    "optimise:once": "tsx infra/scripts/optimisation-loop.ts --once",
    "optimise:loop": "tsx infra/scripts/optimisation-loop.ts",
    "optimise:scorecard": "tsx infra/scripts/optimisation-scorecard.ts",
    "optimise:experiment": "tsx infra/scripts/record-optimisation-experiment.ts",
    "research:audience": "tsx infra/scripts/audience-research.ts --once",
    "research:audience:sanitized": "tsx infra/scripts/record-sanitized-audience-brief.ts",
    "research:audience:loop": "tsx infra/scripts/audience-research.ts",
    "assets:audit": "tsx infra/scripts/audit-asset-library.ts",
    "assets:plan": "tsx infra/scripts/plan-asset-library-growth.ts",
    "assets:register": "tsx infra/scripts/register-asset-batch.ts",
    "assets:qa:visual": "tsx infra/scripts/qa-asset-library-visuals.ts",
    "assets:status": "tsx infra/scripts/audit-asset-library.ts",
    "generate:live": "sh infra/scripts/generate-ghost-live.sh once",
    "generate:live:loop": "sh infra/scripts/generate-ghost-live.sh loop",
    "generate:scripts": "sh infra/scripts/generate-ghost-scripts.sh once",
    "generate:scripts:loop": "sh infra/scripts/generate-ghost-scripts.sh loop",
    "seed:curated-launch": "tsx infra/scripts/seed-curated-launch-pack.ts",
    "seed:signal-surf": "tsx infra/scripts/seed-signal-surf-pack.ts",
    "llm:bulk:start": "sh infra/scripts/start-ghost-bulk-llm.sh",
    "tts:qwen:setup": "sh infra/scripts/setup-ghost-tts.sh",
    "tts:qwen:start": ".venv-tts/bin/python services/tts/qwen_mlx_server.py",
    "tts:qwen:bulk:a": ".venv-tts/bin/python services/tts/qwen_mlx_server.py --port 8880 --model mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-6bit",
    "tts:qwen:bulk:b": ".venv-tts/bin/python services/tts/qwen_mlx_server.py --port 8881 --model mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-6bit",
    "tts:qwen:bulk:c": ".venv-tts/bin/python services/tts/qwen_mlx_server.py --port 8882 --model mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-6bit",
    "tts:qwen:bulk:d": ".venv-tts/bin/python services/tts/qwen_mlx_server.py --port 8883 --model mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-6bit",
    "seed:ghost-quality": "pnpm --filter @elsewhere-cable/generation-worker generate -- --demo --fresh --count 32 --concurrency 1 --tts-base-url http://127.0.0.1:8878/v1 --tts-model mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-bf16",
    "benchmark:renderer": "tsx infra/scripts/benchmark-renderer.ts",
    "benchmark:encoder": "tsx infra/scripts/benchmark-encoder.ts",
    "report": "tsx infra/scripts/generate-report.ts",
    "milestone0": "pnpm diagnose && pnpm build && pnpm benchmark:renderer && pnpm benchmark:encoder && pnpm report",
    "channel:start": "pnpm build && pnpm seed && pnpm --filter @elsewhere-cable/playout-controller start",
    "channel:status": "tsx infra/scripts/channel-status.ts",
    "endor:sync": "sh infra/scripts/sync-endor.sh",
    "endor:publish:once": "tsx infra/scripts/continuous-endor-publisher.ts --once",
    "endor:publish:loop": "tsx infra/scripts/continuous-endor-publisher.ts",
    "endor:capture-played": "tsx infra/scripts/capture-endor-played-ids.ts",
    "endor:deploy": "sh infra/scripts/deploy-endor.sh",
    "endor:status": "sh infra/scripts/endor-status.sh",
    "endor:youtube:key": "sh infra/scripts/endor-youtube-key.sh",
    "endor:youtube:start": "sh infra/scripts/endor-youtube-start.sh",
    "endor:youtube:stop": "sh infra/scripts/endor-youtube-stop.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "playwright-core": "^1.54.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
