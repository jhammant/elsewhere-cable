{
  "name": "elsewhere-cable",
  "version": "0.0.1",
  "private": true,
  "description": "Infinite television from places that do not exist.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm -r build",
    "typecheck": "tsc --noEmit",
    "dev": "pnpm --filter @elsewhere-cable/renderer dev",
    "preview": "pnpm --filter @elsewhere-cable/renderer preview",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "diagnose": "tsx infra/scripts/diagnose.ts --output data/system-profile.json",
    "seed": "pnpm --filter @elsewhere-cable/generation-worker generate -- --demo --if-empty --count 4",
    "generate:batch": "pnpm --filter @elsewhere-cable/generation-worker generate",
    "generate:live:bootstrap": "tsx infra/scripts/bootstrap-live-queue.ts",
    "generate:live": "sh infra/scripts/generate-ghost-live.sh once",
    "generate:live:loop": "sh infra/scripts/generate-ghost-live.sh loop",
    "tts:qwen:setup": "sh infra/scripts/setup-ghost-tts.sh",
    "tts:qwen:start": ".venv-tts/bin/python services/tts/qwen_mlx_server.py",
    "seed:ghost-quality": "pnpm --filter @elsewhere-cable/generation-worker generate -- --demo --fresh --count 32 --concurrency 1 --tts-base-url http://127.0.0.1:8878/v1 --tts-model mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-bf16",
    "benchmark:renderer": "tsx infra/scripts/benchmark-renderer.ts",
    "benchmark:encoder": "tsx infra/scripts/benchmark-encoder.ts",
    "report": "tsx infra/scripts/generate-report.ts",
    "milestone0": "pnpm diagnose && pnpm build && pnpm benchmark:renderer && pnpm benchmark:encoder && pnpm report",
    "channel:start": "pnpm build && pnpm seed && pnpm --filter @elsewhere-cable/playout-controller start",
    "channel:status": "tsx infra/scripts/channel-status.ts",
    "endor:sync": "sh infra/scripts/sync-endor.sh",
    "endor:deploy": "sh infra/scripts/deploy-endor.sh",
    "endor:status": "sh infra/scripts/endor-status.sh",
    "endor:youtube:key": "sh infra/scripts/endor-youtube-key.sh",
    "endor:youtube:start": "sh infra/scripts/endor-youtube-start.sh",
    "endor:youtube:stop": "sh infra/scripts/endor-youtube-stop.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "playwright-core": "^1.54.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
