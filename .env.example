# All services remain localhost-only unless this is changed deliberately.
ELSEWHERE_HOST=127.0.0.1
ELSEWHERE_PORT=4174

# Ghost batch generation defaults to Ollama's OpenAI-compatible endpoint.
ELSEWHERE_LLM_BASE_URL=http://127.0.0.1:11434/v1
ELSEWHERE_LLM_MODEL=llama3.2:3b
# ELSEWHERE_LLM_API_KEY=

# Use an absolute path on Endor when prepared packages are stored outside the checkout.
# ELSEWHERE_SEGMENTS_DIR=/path/to/elsewhere-cable/segments
